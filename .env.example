# Traccar Database Configuration
POSTGRES_DB=traccar
POSTGRES_USER=traccar
POSTGRES_PASSWORD=change_me_secure_password

# Traccar Database Exporter Configuration
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=change_me_secure_password
POSTGRES_EXPORTER_URI=database:5432/traccar?sslmode=disable

# Traccar Grafana Configuration
GRAFANA_ADMIN_PASSWORD=change_me_secure_password

# Traccar Application Configuration
DATABASE_USER=traccar
DATABASE_PASSWORD=change_me_secure_password
DATABASE_URL=jdbc:postgresql://database:5432/traccar

# Optional: Timezone
TZ=UTC